config_version=5

[application]
config/name="Space Opera RPG · Source"
run/main_scene="res://scenes/player_experience.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=980
window/size/window_width_override=1152
window/size/window_height_override=882
window/stretch/mode="canvas_items"

[audio]
driver/driver="Dummy"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.13,0.15,0.14,1)
